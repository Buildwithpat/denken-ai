      "formulaType": "salt-analysis-formula",
      "formulas": [
        {
          "formulaId": "chem_practical_001_f1",
          "name": "Carbonate Test",
          "equation": "CO₃²⁻ + 2HCl → CO₂ + H₂O + 2Cl⁻",
          "latex": "CO_3^{2-}+2HCl\\rightarrow CO_2+H_2O+2Cl^-",
          "meaning": "Effervescence due to CO₂ confirms carbonate ion.",
          "applications": ["Salt analysis", "Qualitative inorganic analysis"]
        },
        {
          "formulaId": "chem_practical_001_f2",
          "name": "Sulphide Test",
          "equation": "S²⁻ + 2HCl → H₂S + 2Cl⁻",
          "latex": "S^{2-}+2HCl\\rightarrow H_2S+2Cl^-",
          "meaning": "Rotten egg smell confirms sulphide ion."
        },
        {
          "formulaId": "chem_practical_001_f3",
          "name": "Sulphate Test",
          "equation": "SO₄²⁻ + BaCl₂ → BaSO₄↓ + 2Cl⁻",
          "latex": "SO_4^{2-}+BaCl_2\\rightarrow BaSO_4\\downarrow+2Cl^-",
          "meaning": "White precipitate confirms sulphate ion."
        }
      ]
