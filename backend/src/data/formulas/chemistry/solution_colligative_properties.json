      "conceptName": "Van't Hoff Factor",
      "description": "Accounts for association or dissociation of solutes.",
      "formulaType": "vant-hoff-formula",
      "formulas": [
        {
          "formulaId": "chem_sol_007_f1",
          "name": "Van't Hoff Factor",
          "equation": "i = Observed colligative property/Calculated colligative property",
          "latex": "i=\\frac{\\text{Observed colligative property}}{\\text{Calculated colligative property}}",
          "meaning": "Correction factor for colligative properties."
        },
        {
          "formulaId": "chem_sol_007_f2",
          "name": "Colligative Property with Van't Hoff Factor",
          "equation": "ΔTb = iKbm",
