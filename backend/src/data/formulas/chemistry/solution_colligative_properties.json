          "meaning": "Boiling point elevation considering dissociation."
        },
        {
          "formulaId": "chem_sol_007_f3",
          "name": "Freezing Point with Van't Hoff Factor",
          "equation": "ΔTf = iKfm",
          "latex": "\\Delta T_f=iK_fm",
          "meaning": "Freezing point depression considering dissociation."
        },
        {
          "formulaId": "chem_sol_007_f4",
          "name": "Osmotic Pressure with Van't Hoff Factor",
          "equation": "π = iCRT",
          "latex": "\\pi=iCRT",
          "meaning": "Corrected osmotic pressure."
