      "conceptId": "chem_elec_001",
      "conceptName": "Electrochemical Cell",
      "description": "Cells converting chemical energy into electrical energy.",
      "formulaType": "cell-formula",
      "formulas": [
        {
          "formulaId": "chem_elec_001_f1",
          "name": "Cell Potential",
          "equation": "Ecell = Ecathode - Eanode",
          "latex": "E_{cell}=E_{cathode}-E_{anode}",
          "meaning": "EMF of electrochemical cell.",
          "variables": {
            "Ecell": {
              "meaning": "Cell potential",
              "unit": "V"
            }
          },
          "applications": ["Galvanic cells", "Electrode potential calculations"]
        },
        {
          "formulaId": "chem_elec_001_f2",
          "name": "Standard Cell Potential",
          "equation": "E°cell = E°cathode - E°anode",
          "latex": "E^\\circ_{cell}=E^\\circ_{cathode}-E^\\circ_{anode}",
          "meaning": "Standard EMF of cell."
        }
      ]
    },
    {
      "conceptId": "chem_elec_002",
      "conceptName": "Nernst Equation",
      "description": "Dependence of electrode potential on concentration.",
      "formulaType": "nernst-formula",
      "formulas": [
        {
          "formulaId": "chem_elec_002_f1",
          "name": "Nernst Equation",
          "equation": "E = E° - (RT/nF) lnQ",
          "latex": "E=E^\\circ-\\frac{RT}{nF}\\ln Q",
          "meaning": "Electrode potential under non-standard conditions."
        },
        {
          "formulaId": "chem_elec_002_f2",
          "name": "Nernst Equation at 298K",
          "equation": "E = E° - (0.0591/n) logQ",
          "latex": "E=E^\\circ-\\frac{0.0591}{n}\\log Q",
          "meaning": "Simplified Nernst equation at room temperature."
        }
      ]
    },
    {
      "conceptId": "chem_elec_003",
      "conceptName": "Gibbs Energy and Cell Potential",
      "description": "Relation between free energy and EMF.",
      "formulaType": "gibbs-electrochemistry-formula",
      "formulas": [
        {
          "formulaId": "chem_elec_003_f1",
          "name": "Gibbs Free Energy Relation",
          "equation": "ΔG = -nFEcell",
          "latex": "\\Delta G=-nFE_{cell}",
          "meaning": "Relation between Gibbs energy and cell potential."
        },
        {
          "formulaId": "chem_elec_003_f2",
          "name": "Standard Gibbs Energy",
          "equation": "ΔG° = -nFE°cell",
          "latex": "\\Delta G^\\circ=-nFE^\\circ_{cell}",
          "meaning": "Standard free energy relation."
        },
        {
          "formulaId": "chem_elec_003_f3",
          "name": "Equilibrium Constant Relation",
          "equation": "E°cell = (0.0591/n) logK",
          "latex": "E^\\circ_{cell}=\\frac{0.0591}{n}\\log K",
          "meaning": "Relation between equilibrium constant and EMF."
        }
      ]
    },
    {
      "conceptId": "chem_elec_004",
      "conceptName": "Conductance",
      "description": "Ability of electrolyte solution to conduct electricity.",
      "formulaType": "conductance-formula",
      "formulas": [
        {
          "formulaId": "chem_elec_004_f1",
          "name": "Conductance",
          "equation": "G = 1/R",
          "latex": "G=\\frac{1}{R}",
          "meaning": "Reciprocal of resistance."
        },
        {
          "formulaId": "chem_elec_004_f2",
          "name": "Specific Conductance",
          "equation": "κ = G(l/A)",
          "latex": "\\kappa=G\\left(\\frac{l}{A}\\right)",
          "meaning": "Conductance of unit cube of solution."
        },
        {
          "formulaId": "chem_elec_004_f3",
          "name": "Molar Conductivity",
          "equation": "Λm = κ × 1000/C",
          "latex": "\\Lambda_m=\\frac{\\kappa\\times1000}{C}",
          "meaning": "Conductivity of one mole electrolyte."
