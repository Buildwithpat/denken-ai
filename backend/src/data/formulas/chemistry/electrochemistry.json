        {
          "formulaId": "chem_elec_006_f2",
          "name": "Electrolysis Equation",
          "equation": "W = Zit",
          "latex": "W=Zit",
          "meaning": "Mass deposited during electrolysis."
        },
        {
          "formulaId": "chem_elec_006_f3",
          "name": "Faraday Constant Relation",
          "equation": "W = (MIt)/(nF)",
          "latex": "W=\\frac{MIt}{nF}",
          "meaning": "Mass deposited using Faraday constant."
        },
        {
          "formulaId": "chem_elec_006_f4",
          "name": "Faraday Constant",
