        {
          "formulaId": "chem_surface_001_f2",
          "name": "Logarithmic Form",
          "equation": "log(x/m) = log k + (1/n) log P",
          "latex": "\\log\\left(\\frac{x}{m}\\right)=\\log k+\\frac{1}{n}\\log P",
          "meaning": "Linear form of Freundlich isotherm."
