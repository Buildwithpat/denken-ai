        {
          "formulaId": "chem_surface_001_f1",
          "name": "Freundlich Adsorption Isotherm",
          "equation": "x/m = kP^(1/n)",
          "latex": "\\frac{x}{m}=kP^{1/n}",
          "meaning": "Relation between pressure and adsorption.",
          "applications": ["Gas adsorption studies", "Surface reactions"]
