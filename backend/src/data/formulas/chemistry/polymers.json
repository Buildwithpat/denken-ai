          "meaning": "Monomers combine to form polymers.",
          "applications": ["Polymer synthesis", "Industrial chemistry"]
        },
        {
          "formulaId": "chem_poly_001_f2",
          "name": "Degree of Polymerization",
          "equation": "n = Molecular mass of polymer / Molecular mass of monomer",
          "latex": "n=\\frac{\\text{Molecular mass of polymer}}{\\text{Molecular mass of monomer}}",
          "meaning": "Number of repeating monomer units."
        }
      ]
