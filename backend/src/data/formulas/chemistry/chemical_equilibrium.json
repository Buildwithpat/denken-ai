          "meaning": "Effect of temperature on equilibrium."
        },
        {
          "formulaId": "chem_eq_005_f2",
          "name": "Pressure Effect",
          "equation": "Increase in pressure favors side with fewer gaseous moles",
          "latex": "\\text{Increase in pressure favors side with fewer gaseous moles}",
          "meaning": "Effect of pressure on equilibrium."
        }
      ]
