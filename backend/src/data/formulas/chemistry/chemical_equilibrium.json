      "description": "Properties and manipulation of equilibrium constants.",
      "formulaType": "equilibrium-property-formula",
      "formulas": [
        {
          "formulaId": "chem_eq_006_f1",
          "name": "Reverse Reaction",
          "equation": "Kreverse = 1/Kforward",
          "latex": "K_{reverse}=\\frac{1}{K_{forward}}",
          "meaning": "Equilibrium constant for reverse reaction."
        },
        {
          "formulaId": "chem_eq_006_f2",
          "name": "Multiplication of Reactions",
          "equation": "Ktotal = K₁ × K₂",
          "latex": "K_{total}=K_1\\times K_2",
          "meaning": "Combined equilibrium constant."
        },
        {
          "formulaId": "chem_eq_006_f3",
          "name": "Reaction Multiplication by n",
          "equation": "Knew = K^n",
          "latex": "K_{new}=K^n",
          "meaning": "Equilibrium constant after multiplying equation."
        }
