      "conceptName": "Law of Mass Action",
      "description": "Relation between concentration and reaction rate.",
      "formulaType": "mass-action-formula",
      "formulas": [
        {
          "formulaId": "chem_eq_001_f1",
          "name": "Equilibrium Constant",
          "equation": "Kc = [C]^c[D]^d / [A]^a[B]^b",
          "latex": "K_c=\\frac{[C]^c[D]^d}{[A]^a[B]^b}",
          "meaning": "Equilibrium constant in terms of concentration.",
          "variables": {
            "Kc": {
              "meaning": "Equilibrium constant",
              "unit": "depends on reaction"
            }
          },
          "applications": [
            "Equilibrium calculations",
            "Reaction direction prediction"
          ]
        },
        {
          "formulaId": "chem_eq_001_f2",
          "name": "Equilibrium Constant in Pressure",
          "equation": "Kp = (PC)^c(PD)^d / (PA)^a(PB)^b",
          "latex": "K_p=\\frac{(P_C)^c(P_D)^d}{(P_A)^a(P_B)^b}",
          "meaning": "Equilibrium constant in terms of partial pressure."
        }
      ]
    },
    {
      "conceptId": "chem_eq_002",
      "conceptName": "Relation Between Kp and Kc",
      "description": "Conversion between pressure and concentration equilibrium constants.",
      "formulaType": "kp-kc-formula",
      "formulas": [
        {
          "formulaId": "chem_eq_002_f1",
          "name": "Kp and Kc Relation",
          "equation": "Kp = Kc(RT)^Δn",
          "latex": "K_p=K_c(RT)^{\\Delta n}",
          "meaning": "Relation between Kp and Kc."
        },
        {
          "formulaId": "chem_eq_002_f2",
          "name": "Change in Moles",
          "equation": "Δn = np(gas) - nr(gas)",
          "latex": "\\Delta n=n_p(\\text{gas})-n_r(\\text{gas})",
          "meaning": "Difference in gaseous moles."
        }
      ]
    },
    {
      "conceptId": "chem_eq_003",
      "conceptName": "Reaction Quotient",
      "description": "Predicts direction of reaction.",
      "formulaType": "reaction-quotient-formula",
      "formulas": [
        {
          "formulaId": "chem_eq_003_f1",
          "name": "Reaction Quotient",
          "equation": "Qc = [C]^c[D]^d / [A]^a[B]^b",
          "latex": "Q_c=\\frac{[C]^c[D]^d}{[A]^a[B]^b}",
          "meaning": "Reaction quotient at any instant."
        },
        {
          "formulaId": "chem_eq_003_f2",
          "name": "Direction Condition",
          "equation": "Qc < Kc → forward reaction",
          "latex": "Q_c<K_c\\rightarrow\\text{forward reaction}",
          "meaning": "Predicts direction toward equilibrium."
        },
        {
          "formulaId": "chem_eq_003_f3",
          "name": "Reverse Direction Condition",
          "equation": "Qc > Kc → backward reaction",
          "latex": "Q_c>K_c\\rightarrow\\text{backward reaction}",
          "meaning": "Reaction proceeds backward."
        }
      ]
    },
    {
      "conceptId": "chem_eq_004",
      "conceptName": "Degree of Dissociation",
      "description": "Extent of dissociation of substances.",
      "formulaType": "dissociation-formula",
      "formulas": [
        {
          "formulaId": "chem_eq_004_f1",
          "name": "Degree of Dissociation",
          "equation": "α = Dissociated moles / Initial moles",
          "latex": "\\alpha=\\frac{\\text{Dissociated moles}}{\\text{Initial moles}}",
          "meaning": "Fraction of substance dissociated."
        },
        {
          "formulaId": "chem_eq_004_f2",
          "name": "Van't Hoff Factor",
          "equation": "i = 1 + (n - 1)α",
          "latex": "i=1+(n-1)\\alpha",
          "meaning": "Relation between van't Hoff factor and dissociation."
        }
      ]
    },
    {
