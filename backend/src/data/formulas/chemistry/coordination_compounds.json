    {
      "conceptId": "chem_coord_005",
      "conceptName": "Valence Bond Theory",
      "description": "Hybridization and geometry of complexes.",
      "formulaType": "vbt-formula",
      "formulas": [
        {
          "formulaId": "chem_coord_005_f1",
          "name": "Magnetic Moment",
          "equation": "μ = √n(n+2) BM",
          "latex": "\\mu=\\sqrt{n(n+2)}\\,BM",
          "meaning": "Magnetic moment of coordination compounds."
        },
        {
          "formulaId": "chem_coord_005_f2",
          "name": "Square Planar Hybridization",
          "equation": "dsp²",
          "latex": "dsp^2",
          "meaning": "Hybridization for square planar geometry."
        },
        {
          "formulaId": "chem_coord_005_f3",
          "name": "Octahedral Inner Orbital Complex",
          "equation": "d²sp³",
          "latex": "d^2sp^3",
          "meaning": "Hybridization for inner orbital octahedral complex."
        },
        {
          "formulaId": "chem_coord_005_f4",
          "name": "Octahedral Outer Orbital Complex",
          "equation": "sp³d²",
          "latex": "sp^3d^2",
          "meaning": "Hybridization for outer orbital octahedral complex."
        }
      ]
    },
    {
      "conceptId": "chem_coord_006",
      "conceptName": "Crystal Field Theory",
      "description": "Splitting of d-orbitals in ligand field.",
      "formulaType": "cft-formula",
      "formulas": [
        {
          "formulaId": "chem_coord_006_f1",
          "name": "Crystal Field Splitting Energy",
          "equation": "Δ₀ = Energy gap between t₂g and eg orbitals",
          "latex": "\\Delta_0=\\text{Energy gap between }t_{2g}\\text{ and }e_g\\text{ orbitals}",
          "meaning": "Octahedral crystal field splitting."
        },
        {
          "formulaId": "chem_coord_006_f2",
          "name": "Tetrahedral Splitting",
          "equation": "Δt = (4/9)Δ₀",
          "latex": "\\Delta_t=\\frac{4}{9}\\Delta_0",
          "meaning": "Relation between tetrahedral and octahedral splitting."
        },
        {
          "formulaId": "chem_coord_006_f3",
          "name": "CFSE Formula",
          "equation": "CFSE = (-0.4 × nₜ₂g + 0.6 × neg)Δ₀",
          "latex": "CFSE=(-0.4\\times n_{t_{2g}}+0.6\\times n_{e_g})\\Delta_0",
          "meaning": "Crystal field stabilization energy."
        }
      ]
