          "formulaId": "chem_coord_001_f1",
          "name": "Coordination Number",
          "equation": "CN = Number of donor atoms attached to central metal",
          "latex": "CN=\\text{Number of donor atoms attached to central metal}",
          "meaning": "Total number of coordinate bonds formed by central atom.",
          "applications": ["Geometry prediction", "Hybridization determination"]
