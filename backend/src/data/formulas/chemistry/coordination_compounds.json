      "description": "Charge on central metal atom.",
      "formulaType": "oxidation-formula",
      "formulas": [
        {
          "formulaId": "chem_coord_003_f1",
          "name": "Oxidation State Rule",
          "equation": "Oxidation state + ligand charges = complex charge",
          "latex": "\\text{Oxidation state}+\\text{ligand charges}=\\text{complex charge}",
          "meaning": "Used to determine oxidation number of metal."
        }
      ]
    },
    {
      "conceptId": "chem_coord_004",
      "conceptName": "Effective Atomic Number",
      "description": "Total electrons around central metal.",
      "formulaType": "ean-formula",
      "formulas": [
        {
          "formulaId": "chem_coord_004_f1",
          "name": "EAN Formula",
          "equation": "EAN = Z - Oxidation state + electrons donated by ligands",
          "latex": "EAN=Z-\\text{Oxidation state}+\\text{electrons donated by ligands}",
          "meaning": "Effective atomic number calculation."
        }
      ]
