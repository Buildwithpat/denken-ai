      "conceptId": "chem_coord_007",
      "conceptName": "Isomerism",
      "description": "Different arrangements in coordination compounds.",
      "formulaType": "isomerism-formula",
      "formulas": [
        {
          "formulaId": "chem_coord_007_f1",
          "name": "Geometrical Isomerism",
          "equation": "cis ↔ trans",
          "latex": "cis\\leftrightarrow trans",
          "meaning": "Different spatial arrangement of ligands."
        },
        {
          "formulaId": "chem_coord_007_f2",
          "name": "Optical Isomerism",
          "equation": "d-form ≠ l-form",
          "latex": "d\\text{-form}\\neq l\\text{-form}",
          "meaning": "Non-superimposable mirror images."
        }
      ]
    },
