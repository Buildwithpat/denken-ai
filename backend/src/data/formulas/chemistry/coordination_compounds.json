      "formulas": [
        {
          "formulaId": "chem_coord_002_f1",
          "name": "Primary Valency",
          "equation": "Primary valency = Oxidation state",
          "latex": "\\text{Primary valency}=\\text{Oxidation state}",
          "meaning": "Ionizable valency satisfied by negative ions."
        },
        {
          "formulaId": "chem_coord_002_f2",
          "name": "Secondary Valency",
          "equation": "Secondary valency = Coordination number",
          "latex": "\\text{Secondary valency}=\\text{Coordination number}",
          "meaning": "Non-ionizable valency satisfied by ligands."
        }
      ]
    },
