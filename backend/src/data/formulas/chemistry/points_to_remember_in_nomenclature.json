          "meaning": "Parent chain must contain maximum carbons."
        },
        {
          "formulaId": "chem_nom_001_f2",
          "name": "Lowest Locant Rule",
          "equation": "Substituents get minimum possible numbers",
          "latex": "\\text{Substituents get minimum possible numbers}",
          "meaning": "Numbering starts from nearest substituent."
        },
        {
          "formulaId": "chem_nom_001_f3",
          "name": "Priority Rule",
