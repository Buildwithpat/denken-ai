      "description": "Instrument used for measuring small thickness.",
      "formulaType": "screw-gauge-formula",
      "formulas": [
        {
          "formulaId": "phy_err_007_f1",
          "name": "Pitch",
          "equation": "Pitch = Distance moved / Number of rotations",
          "latex": "\\text{Pitch}=\\frac{\\text{Distance moved}}{\\text{Number of rotations}}",
          "meaning": "Pitch of screw gauge."
        },
        {
          "formulaId": "phy_err_007_f2",
          "name": "Least Count of Screw Gauge",
          "equation": "LC = Pitch / Number of circular divisions",
          "latex": "LC=\\frac{\\text{Pitch}}{\\text{Number of circular divisions}}",
          "meaning": "Least count of screw gauge."
        }
      ]
