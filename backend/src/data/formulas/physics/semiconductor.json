    {
      "conceptId": "phy_semi_006",
      "conceptName": "Transistor",
      "description": "Current amplification using transistor.",
      "formulaType": "transistor-formula",
      "formulas": [
        {
          "formulaId": "phy_semi_006_f1",
          "name": "Emitter Current Relation",
          "equation": "IE = IC + IB",
          "latex": "I_E=I_C+I_B",
          "meaning": "Relation between transistor currents."
        },
        {
          "formulaId": "phy_semi_006_f2",
          "name": "Current Gain in CE Mode",
          "equation": "β = IC/IB",
          "latex": "\\beta=\\frac{I_C}{I_B}",
          "meaning": "Current amplification factor in common emitter."
        },
        {
          "formulaId": "phy_semi_006_f3",
          "name": "Current Gain in CB Mode",
          "equation": "α = IC/IE",
          "latex": "\\alpha=\\frac{I_C}{I_E}",
          "meaning": "Current gain in common base."
        },
        {
          "formulaId": "phy_semi_006_f4",
          "name": "Relation Between α and β",
          "equation": "β = α/(1-α)",
          "latex": "\\beta=\\frac{\\alpha}{1-\\alpha}",
          "meaning": "Relation between transistor gains."
        }
      ]
    },
