        {
          "formulaId": "phy_semi_004_f1",
          "name": "Rectification Efficiency",
          "equation": "η = Pdc/Pac",
          "latex": "\\eta=\\frac{P_{dc}}{P_{ac}}",
          "meaning": "Efficiency of rectifier."
        },
        {
          "formulaId": "phy_semi_004_f2",
          "name": "Ripple Factor",
          "equation": "γ = Vac/Vdc",
          "latex": "\\gamma=\\frac{V_{ac}}{V_{dc}}",
          "meaning": "Measure of AC content in rectifier output."
        }
      ]
    },
