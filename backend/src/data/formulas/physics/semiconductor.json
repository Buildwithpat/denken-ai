      "conceptName": "Semiconductor Basics",
      "description": "Properties and behavior of semiconductors.",
      "formulaType": "basic-formula",
      "formulas": [
        {
          "formulaId": "phy_semi_001_f1",
          "name": "Current Density",
          "equation": "J = nevd",
          "latex": "J=nev_d",
          "meaning": "Current density in semiconductor.",
          "variables": {
            "J": {
              "meaning": "Current density",
              "unit": "A/m²"
            },
            "n": {
              "meaning": "Charge carrier density",
              "unit": "m⁻³"
            },
            "e": {
              "meaning": "Electronic charge",
              "unit": "C"
            },
            "vd": {
              "meaning": "Drift velocity",
              "unit": "m/s"
            }
          },
          "applications": ["Semiconductor conduction", "Current analysis"]
        },
        {
          "formulaId": "phy_semi_001_f2",
          "name": "Conductivity",
          "equation": "σ = neμ",
          "latex": "\\sigma=ne\\mu",
          "meaning": "Conductivity of semiconductor."
        },
        {
          "formulaId": "phy_semi_001_f3",
          "name": "Resistivity",
          "equation": "ρ = 1/σ",
          "latex": "\\rho=\\frac{1}{\\sigma}",
          "meaning": "Resistivity of semiconductor."
        }
      ]
    },
    {
      "conceptId": "phy_semi_002",
      "conceptName": "Drift and Mobility",
      "description": "Motion of charge carriers under electric field.",
      "formulaType": "mobility-formula",
      "formulas": [
        {
          "formulaId": "phy_semi_002_f1",
          "name": "Drift Velocity",
          "equation": "vd = μE",
          "latex": "v_d=\\mu E",
          "meaning": "Drift velocity under electric field."
        },
        {
          "formulaId": "phy_semi_002_f2",
          "name": "Mobility",
          "equation": "μ = vd/E",
          "latex": "\\mu=\\frac{v_d}{E}",
          "meaning": "Mobility of charge carriers."
        }
      ]
    },
    {
      "conceptId": "phy_semi_003",
      "conceptName": "PN Junction Diode",
      "description": "Behavior and characteristics of PN junction.",
      "formulaType": "diode-formula",
      "formulas": [
        {
          "formulaId": "phy_semi_003_f1",
          "name": "Diode Current Equation",
          "equation": "I = I₀(e^(eV/kT) - 1)",
          "latex": "I=I_0\\left(e^{\\frac{eV}{kT}}-1\\right)",
          "meaning": "Current through PN junction diode."
        },
        {
          "formulaId": "phy_semi_003_f2",
          "name": "Dynamic Resistance",
          "equation": "rd = ΔV/ΔI",
          "latex": "r_d=\\frac{\\Delta V}{\\Delta I}",
          "meaning": "Dynamic resistance of diode."
        },
        {
          "formulaId": "phy_semi_003_f3",
          "name": "Barrier Potential",
          "equation": "Vb ≈ 0.7V (Si), 0.3V (Ge)",
          "latex": "V_b\\approx0.7V\\,(Si),\\,0.3V\\,(Ge)",
          "meaning": "Typical barrier potential values."
        }
      ]
