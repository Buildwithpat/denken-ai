        {
          "formulaId": "math_itf_008_f1",
          "name": "Derivative of sin⁻¹x",
          "equation": "d/dx(sin⁻¹x) = 1/√(1-x²)",
          "latex": "\\frac{d}{dx}(\\sin^{-1}x)=\\frac1{\\sqrt{1-x^2}}",
