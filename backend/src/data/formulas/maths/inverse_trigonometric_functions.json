      "description": "Definitions of inverse trigonometric functions.",
      "formulaType": "inverse-trig-definition-formula",
      "formulas": [
        {
          "formulaId": "math_itf_001_f1",
          "name": "Inverse Sine",
          "equation": "y = sin⁻¹x ⇔ x = siny",
          "latex": "y=\\sin^{-1}x\\iff x=\\sin y",
          "meaning": "Definition of inverse sine function.",
          "applications": ["Trigonometric equations", "Calculus"]
        },
        {
          "formulaId": "math_itf_001_f2",
          "name": "Inverse Cosine",
          "equation": "y = cos⁻¹x ⇔ x = cosy",
          "latex": "y=\\cos^{-1}x\\iff x=\\cos y",
          "meaning": "Definition of inverse cosine."
        },
        {
          "formulaId": "math_itf_001_f3",
          "name": "Inverse Tangent",
          "equation": "y = tan⁻¹x ⇔ x = tany",
          "latex": "y=\\tan^{-1}x\\iff x=\\tan y",
          "meaning": "Definition of inverse tangent."
        }
      ]
    },
    {
      "conceptId": "math_itf_002",
