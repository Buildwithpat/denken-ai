          "meaning": "Principal value range of inverse sine."
        },
        {
          "formulaId": "math_itf_002_f2",
          "name": "Range of cos⁻¹x",
          "equation": "[0, π]",
          "latex": "\\left[0,\\pi\\right]",
          "meaning": "Principal value range of inverse cosine."
        },
        {
          "formulaId": "math_itf_002_f3",
          "name": "Range of tan⁻¹x",
          "equation": "(-π/2, π/2)",
          "latex": "\\left(-\\frac\\pi2,\\frac\\pi2\\right)",
          "meaning": "Principal value range of inverse tangent."
        }
      ]
