    {
      "conceptId": "math_itf_003",
      "conceptName": "Basic Identities",
      "description": "Important inverse trigonometric identities.",
      "formulaType": "inverse-trig-identity-formula",
      "formulas": [
        {
          "formulaId": "math_itf_003_f1",
          "name": "sin⁻¹x + cos⁻¹x",
          "equation": "sin⁻¹x + cos⁻¹x = π/2",
          "latex": "\\sin^{-1}x+\\cos^{-1}x=\\frac\\pi2",
          "meaning": "Fundamental identity."
        },
        {
          "formulaId": "math_itf_003_f2",
          "name": "tan⁻¹x + cot⁻¹x",
          "equation": "tan⁻¹x + cot⁻¹x = π/2",
          "latex": "\\tan^{-1}x+\\cot^{-1}x=\\frac\\pi2",
          "meaning": "Inverse tangent-cotangent identity."
        },
        {
          "formulaId": "math_itf_003_f3",
          "name": "sec⁻¹x + cosec⁻¹x",
          "equation": "sec⁻¹x + cosec⁻¹x = π/2",
          "latex": "\\sec^{-1}x+\\csc^{-1}x=\\frac\\pi2",
          "meaning": "Inverse secant-cosecant identity."
        }
      ]
    },
    {
      "conceptId": "math_itf_004",
      "conceptName": "Transformation Formulas",
      "description": "Relations involving negative arguments.",
      "formulaType": "transformation-formula",
      "formulas": [
        {
          "formulaId": "math_itf_004_f1",
          "name": "sin⁻¹(-x)",
          "equation": "sin⁻¹(-x) = -sin⁻¹x",
          "latex": "\\sin^{-1}(-x)=-\\sin^{-1}x",
          "meaning": "Odd function property."
        },
        {
          "formulaId": "math_itf_004_f2",
          "name": "cos⁻¹(-x)",
          "equation": "cos⁻¹(-x) = π - cos⁻¹x",
          "latex": "\\cos^{-1}(-x)=\\pi-\\cos^{-1}x",
          "meaning": "Transformation identity."
        },
        {
          "formulaId": "math_itf_004_f3",
          "name": "tan⁻¹(-x)",
          "equation": "tan⁻¹(-x) = -tan⁻¹x",
          "latex": "\\tan^{-1}(-x)=-\\tan^{-1}x",
          "meaning": "Odd function property."
        }
      ]
    },
    {
      "conceptId": "math_itf_005",
      "conceptName": "Compound Angle Identities",
      "description": "Addition and subtraction identities.",
      "formulaType": "compound-angle-formula",
      "formulas": [
        {
          "formulaId": "math_itf_005_f1",
          "name": "tan⁻¹x + tan⁻¹y",
          "equation": "tan⁻¹x + tan⁻¹y = tan⁻¹[(x+y)/(1-xy)]",
          "latex": "\\tan^{-1}x+\\tan^{-1}y=\\tan^{-1}\\left(\\frac{x+y}{1-xy}\\right)",
          "meaning": "Addition formula for inverse tangent."
        },
        {
          "formulaId": "math_itf_005_f2",
          "name": "tan⁻¹x - tan⁻¹y",
          "equation": "tan⁻¹x - tan⁻¹y = tan⁻¹[(x-y)/(1+xy)]",
          "latex": "\\tan^{-1}x-\\tan^{-1}y=\\tan^{-1}\\left(\\frac{x-y}{1+xy}\\right)",
          "meaning": "Subtraction formula."
        }
      ]
    },
    {
      "conceptId": "math_itf_006",
      "conceptName": "Conversion Identities",
      "description": "Relations between inverse trigonometric functions.",
      "formulaType": "conversion-formula",
      "formulas": [
        {
          "formulaId": "math_itf_006_f1",
          "name": "tan⁻¹x in terms of sin⁻¹x",
          "equation": "tan⁻¹x = sin⁻¹[x/√(1+x²)]",
          "latex": "\\tan^{-1}x=\\sin^{-1}\\left(\\frac{x}{\\sqrt{1+x^2}}\\right)",
          "meaning": "Conversion identity."
        },
        {
          "formulaId": "math_itf_006_f2",
          "name": "tan⁻¹x in terms of cos⁻¹x",
          "equation": "tan⁻¹x = cos⁻¹[1/√(1+x²)]",
          "latex": "\\tan^{-1}x=\\cos^{-1}\\left(\\frac1{\\sqrt{1+x^2}}\\right)",
          "meaning": "Another conversion identity."
        }
      ]
    },
    {
      "conceptId": "math_itf_007",
