    {
      "conceptId": "math_quad_003",
      "conceptName": "Discriminant",
      "description": "Expression determining nature of roots.",
      "formulaType": "discriminant-formula",
      "formulas": [
        {
          "formulaId": "math_quad_003_f1",
          "name": "Discriminant",
          "equation": "D = b² - 4ac",
          "latex": "D=b^2-4ac",
          "meaning": "Determines nature of roots."
        },
        {
          "formulaId": "math_quad_003_f2",
          "name": "Real and Distinct Roots",
          "equation": "D > 0",
          "latex": "D>0",
          "meaning": "Roots are real and unequal."
        },
        {
          "formulaId": "math_quad_003_f3",
          "name": "Equal Roots",
          "equation": "D = 0",
          "latex": "D=0",
          "meaning": "Roots are equal."
        },
        {
          "formulaId": "math_quad_003_f4",
          "name": "Imaginary Roots",
          "equation": "D < 0",
          "latex": "D<0",
          "meaning": "Roots are complex."
        }
      ]
