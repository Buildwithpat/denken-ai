      "description": "Conditions for special roots.",
      "formulaType": "nature-roots-formula",
      "formulas": [
        {
          "formulaId": "math_quad_006_f1",
          "name": "Roots of Opposite Signs",
          "equation": "αβ < 0",
          "latex": "\\alpha\\beta<0",
          "meaning": "Roots have opposite signs."
        },
        {
          "formulaId": "math_quad_006_f2",
          "name": "Both Roots Positive",
