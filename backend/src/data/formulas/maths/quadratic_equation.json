    {
      "conceptId": "math_quad_004",
      "conceptName": "Relations Between Roots and Coefficients",
      "description": "Important root relations.",
      "formulaType": "roots-coefficients-formula",
      "formulas": [
        {
          "formulaId": "math_quad_004_f1",
          "name": "Sum of Roots",
          "equation": "α + β = -b/a",
          "latex": "\\alpha+\\beta=-\\frac{b}{a}",
          "meaning": "Sum of roots relation."
        },
        {
          "formulaId": "math_quad_004_f2",
          "name": "Product of Roots",
          "equation": "αβ = c/a",
          "latex": "\\alpha\\beta=\\frac{c}{a}",
          "meaning": "Product of roots relation."
        }
      ]
    },
    {
      "conceptId": "math_quad_005",
      "conceptName": "Formation of Quadratic Equation",
      "description": "Equation formed from given roots.",
      "formulaType": "formation-formula",
      "formulas": [
        {
          "formulaId": "math_quad_005_f1",
          "name": "Equation from Roots",
          "equation": "x² - (α+β)x + αβ = 0",
          "latex": "x^2-(\\alpha+\\beta)x+\\alpha\\beta=0",
          "meaning": "Quadratic equation with roots α and β."
        }
      ]
    },
    {
