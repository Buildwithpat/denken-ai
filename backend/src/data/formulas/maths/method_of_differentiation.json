          "formulaId": "math_diff_007_f1",
          "name": "Implicit Differentiation",
          "equation": "Differentiate both sides w.r.t x",
          "latex": "\\text{Differentiate both sides with respect to }x",
          "meaning": "Method for implicit functions."
        }
      ]
    },
    {
      "conceptId": "math_diff_008",
      "conceptName": "Parametric Differentiation",
      "description": "Derivative for parametric equations.",
      "formulaType": "parametric-differentiation-formula",
      "formulas": [
        {
          "formulaId": "math_diff_008_f1",
          "name": "Parametric Derivative",
          "equation": "dy/dx = (dy/dt)/(dx/dt)",
          "latex": "\\frac{dy}{dx}=\\frac{dy/dt}{dx/dt}",
          "meaning": "Derivative in parametric form."
        }
      ]
    },
    {
      "conceptId": "math_diff_009",
