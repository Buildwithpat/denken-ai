  "concepts": [
    {
      "conceptId": "math_circle_001",
      "conceptName": "Standard Equation of Circle",
      "description": "Basic equation of circle with center and radius.",
      "formulaType": "circle-equation-formula",
      "formulas": [
        {
          "formulaId": "math_circle_001_f1",
          "name": "Standard Form",
          "equation": "(x-h)² + (y-k)² = r²",
          "latex": "(x-h)^2+(y-k)^2=r^2",
          "meaning": "Equation of circle with center (h,k) and radius r.",
          "applications": ["Coordinate geometry", "Conic sections"]
        },
        {
          "formulaId": "math_circle_001_f2",
          "name": "Circle at Origin",
          "equation": "x² + y² = r²",
          "latex": "x^2+y^2=r^2",
          "meaning": "Equation of circle centered at origin."
        }
      ]
    },
    {
      "conceptId": "math_circle_002",
      "conceptName": "General Equation of Circle",
      "description": "Expanded form of circle equation.",
      "formulaType": "general-circle-formula",
      "formulas": [
        {
          "formulaId": "math_circle_002_f1",
          "name": "General Form",
          "equation": "x² + y² + 2gx + 2fy + c = 0",
          "latex": "x^2+y^2+2gx+2fy+c=0",
          "meaning": "General equation of circle."
        },
        {
          "formulaId": "math_circle_002_f2",
          "name": "Center of Circle",
          "equation": "(-g,-f)",
          "latex": "(-g,-f)",
          "meaning": "Coordinates of center from general equation."
        },
        {
          "formulaId": "math_circle_002_f3",
          "name": "Radius Formula",
          "equation": "r = √(g² + f² - c)",
          "latex": "r=\\sqrt{g^2+f^2-c}",
          "meaning": "Radius from general equation."
        }
      ]
    },
    {
      "conceptId": "math_circle_003",
      "conceptName": "Condition for Circle",
      "description": "Conditions for existence of real circle.",
      "formulaType": "condition-formula",
      "formulas": [
        {
          "formulaId": "math_circle_003_f1",
          "name": "Real Circle Condition",
          "equation": "g² + f² - c > 0",
          "latex": "g^2+f^2-c>0",
          "meaning": "Condition for real circle."
        },
        {
          "formulaId": "math_circle_003_f2",
          "name": "Point Circle Condition",
          "equation": "g² + f² - c = 0",
          "latex": "g^2+f^2-c=0",
          "meaning": "Circle reduces to a point."
        }
      ]
    },
    {
      "conceptId": "math_circle_004",
      "conceptName": "Tangent to Circle",
      "description": "Equation of tangent at a point.",
      "formulaType": "tangent-formula",
      "formulas": [
        {
          "formulaId": "math_circle_004_f1",
          "name": "Tangent at Point",
          "equation": "xx₁ + yy₁ = r²",
          "latex": "xx_1+yy_1=r^2",
          "meaning": "Tangent to x²+y²=r² at point (x₁,y₁)."
        },
        {
          "formulaId": "math_circle_004_f2",
          "name": "Condition of Tangency",
          "equation": "Distance from center = radius",
          "latex": "\\text{Distance from center}=\\text{radius}",
          "meaning": "Condition for line to touch circle."
        }
      ]
    },
