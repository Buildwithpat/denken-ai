      "conceptId": "math_pnc_009",
      "conceptName": "Derangements",
      "description": "Permutations where no object remains in original position.",
      "formulaType": "derangement-formula",
      "formulas": [
        {
          "formulaId": "math_pnc_009_f1",
          "name": "Derangement Formula",
          "equation": "!n = n![1 - 1/1! + 1/2! - 1/3! + ...]",
          "latex": "!n=n!\\left[1-\\frac1{1!}+\\frac1{2!}-\\frac1{3!}+\\cdots\\right]",
