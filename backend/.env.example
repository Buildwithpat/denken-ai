PORT=5000
MONGO_URI=mongodb://localhost:27017/denken-ai
AI_SERVICE_URL=http://localhost:8000
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=7d

# Redis — run `docker compose up -d redis` to start locally
# Leave empty to disable caching (works without Redis, just slower)
REDIS_URL=redis://localhost:6379

# Razorpay — get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Development flags
NODE_ENV=development
DEV_MODE=false
