# AI Provider: "mock" | "gemini" | "openrouter"
AI_PROVIDER=mock

# Gemini — required when AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter — required when AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct

# Redis — optional; enables response caching for Gemini calls
# Leave empty to disable caching
REDIS_URL=redis://localhost:6379

# ChromaDB — local vector store path
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=denken_notes

# Embeddings model (downloaded on first use)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5000"]

# Environment
APP_ENV=development
